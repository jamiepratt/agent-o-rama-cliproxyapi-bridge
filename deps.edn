{:paths ["ipc/src" "ipc/resources"]
 :mvn/repos {"rpl" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :deps {com.google.code.gson/gson {:mvn/version "2.12.1"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/clojure {:mvn/version "1.12.4"}
        com.rpl/rama {:mvn/version "1.9.0"}
        com.rpl/agent-o-rama {:mvn/version "0.10.0"}
        dev.langchain4j/langchain4j-open-ai-official {:mvn/version "1.18.1-beta28"}}
 :aliases {:commands-test {:extra-paths ["ipc/test"]
                           :main-opts ["-m" "bridge.commands-test"]}
           :live {:extra-paths ["ipc/test"]
                  :jvm-opts ["-Xss6m" "-Xmx4g" "-Djdk.attach.allowAttachSelf"]
                  :main-opts ["-m" "bridge.live"]}
           :test {:extra-paths ["ipc/test"]
                  :jvm-opts ["-Xss6m" "-Xmx4g" "-Djdk.attach.allowAttachSelf"]
                  :main-opts ["-m" "bridge.ipc-test"]}}}
