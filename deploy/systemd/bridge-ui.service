[Unit]
Description=Private bridge ui
Requires=bridge-firewall.service
After=network-online.target bridge-firewall.service bridge-supervisor.service bridge-proxy.service
StartLimitIntervalSec=300
StartLimitBurst=5
[Service]
Type=simple
User=bridge-rama
Group=bridge-rama
WorkingDirectory=/opt/bridge/current/rama
ExecStart=/opt/bridge/current/rama/rama runClj bridge.runtime /opt/bridge/module.jar
ReadWritePaths=/var/lib/bridge-rama /var/log/bridge-rama
Environment="JAVA_TOOL_OPTIONS=-Xmx768m -Xss6m"
Restart=on-failure
RestartSec=10s
TimeoutStopSec=120s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536
StandardOutput=null
StandardError=null
[Install]
WantedBy=multi-user.target
